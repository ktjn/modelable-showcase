// Compatibility suite baseline (IMPLEMENTATION_PLAN.md Task 4.1, SPEC.md
// Sec 11). This is a minimal standalone workspace - not a copy of the
// showcase's real model/patient.mdl - carrying just enough shape to make
// every specific evolution in ../additive-v2/ and ../breaking-v3/
// meaningful when diffed against it. Deliberately validates on its own,
// with no @2/@3 declared here, so it also proves the pre-evolution
// baseline is independently valid.
domain compat {
  owner: "conformance-fixtures"

  entity Patient @ 1 (additive) {
    @key
    patientId: uuid

    legalName: string
    dateOfBirth: date
    contactPhone?: string
    status: enum(active, inactive)

    @pii
    ssn: string
  }

  projection PatientSummary @ 1
    from compat.Patient @ 1 as p
  {
    patientId <- p.patientId
    legalName <- p.legalName
    @pii ssn <- p.ssn

    access {
      entity * [read]
      property ssn admin-team [read, write]
    }
  }
}
