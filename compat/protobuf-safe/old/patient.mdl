// Compatibility suite: Protobuf-target reservation-safe evolution
// (IMPLEMENTATION_PLAN.md Task 4.2, SPEC.md Sec 11). "old" side: the
// pre-evolution schema, standalone from ../new/. Field declaration order
// determines Protobuf field numbers (patientId=1, legalName=2,
// legacyNotes=3 - verified against real `compile --target protobuf`
// output before writing ../new/'s reservation).
domain compat {
  owner: "conformance-fixtures"

  entity Patient @ 1 (additive) {
    @key
    patientId: uuid

    legalName: string
    legacyNotes: string
  }
}
