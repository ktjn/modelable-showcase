// Compatibility suite: gRPC read-index change classification
// (IMPLEMENTATION_PLAN.md Task 4.2, SPEC.md Sec 11). "old" side declares
// a secondary index on `status`. The Scalable gRPC profile
// (`compile --target grpc`) surfaces declared indexes as
// `read_indexes` service-manifest metadata (docs/cli-reference.md Sec
// 5.22); `modelable validate-compat --target grpc` diffs that metadata
// specifically, separately from the Protobuf wire-schema comparison
// `--target protobuf` performs on the same two directories.
domain compat {
  owner: "conformance-fixtures"

  entity Patient @ 1 (additive) {
    @key
    patientId: uuid

    legalName: string
    status: enum(active, inactive)
  }

  index Patient @ 1 {
    primary patientId

    secondary byStatus {
      key: [status]
    }
  }
}
