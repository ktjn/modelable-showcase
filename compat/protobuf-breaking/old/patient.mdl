// Compatibility suite: Protobuf field-number/name reuse rejection
// (IMPLEMENTATION_PLAN.md Task 4.2, SPEC.md Sec 11). "old" side, mirroring
// ../protobuf-safe/old/patient.mdl's field layout (patientId=1,
// legalName=2, legacyNotes=3) but paired here with a "new" side that
// reuses field number 3 for an unrelated field with no reservation at
// all - the case this fixture exists to reject.
domain compat {
  owner: "conformance-fixtures"

  entity Patient @ 1 (additive) {
    @key
    patientId: uuid

    legalName: string
    legacyNotes: string
  }
}
