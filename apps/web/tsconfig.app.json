{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@generated/*": ["../../generated/typescript/*"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // Modelable 1.11+ emits real `enum` declarations for nominal semantic
    // enums (model/scheduling.mdl AppointmentStatus, model/billing.mdl
    // InvoiceStatus) - not erasable syntax, so this can no longer be on for
    // a workspace that imports generated TypeScript. See
    // UPSTREAM_FINDINGS.md.
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
