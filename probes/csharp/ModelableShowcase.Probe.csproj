<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>ModelableShowcase.Probe</RootNamespace>
    <AssemblyName>ModelableShowcase.Probe</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Generated C# sources are linked from the disposable generated/ tree, never
       copied into git (IMPLEMENTATION_PLAN.md Task 7.2). Under the pinned 1.8.0
       release the patient.* and scheduling.* artifacts all resolve within their
       own namespace (UPSTREAM_FINDINGS.md #15/#16 fixed via #365), so they are
       linked here and carry the instantiate/serialize proof.

       Everything else the csharp target emits still fails `dotnet build` with
       CS0246: references to types declared in another domain are emitted bare
       with no `using` import (UPSTREAM_FINDINGS.md #28), e.g. billing.* uses
       PatientPatientId, clinical.* uses PatientPatientId/SchedulingPractitionerId/
       PatientContactDetailsV0, reporting.* uses PatientPatientId/
       SchedulingTimeRangeV0.

       Revisit once Modelable is re-pinned past a release that fixes #28: the
       full generated/csharp/ set should become linkable at that point.
       tests/integration/test_csharp_codegen.py asserts the full-set failure
       explicitly so it flips when the emitter is fixed upstream. -->
  <ItemGroup>
    <Compile Include="../../generated/csharp/patient.Address.v0.cs" Link="generated/patient.Address.v0.cs" />
    <Compile Include="../../generated/csharp/patient.ContactDetails.v0.cs" Link="generated/patient.ContactDetails.v0.cs" />
    <Compile Include="../../generated/csharp/patient.Patient.v1.cs" Link="generated/patient.Patient.v1.cs" />
    <Compile Include="../../generated/csharp/patient.Patient.v2.cs" Link="generated/patient.Patient.v2.cs" />
    <Compile Include="../../generated/csharp/patient.PatientDb.v2.cs" Link="generated/patient.PatientDb.v2.cs" />
    <Compile Include="../../generated/csharp/patient.PatientEvent.v2.cs" Link="generated/patient.PatientEvent.v2.cs" />
    <Compile Include="../../generated/csharp/patient.PatientReply.v2.cs" Link="generated/patient.PatientReply.v2.cs" />
    <Compile Include="../../generated/csharp/patient.PatientRequest.v2.cs" Link="generated/patient.PatientRequest.v2.cs" />
    <Compile Include="../../generated/csharp/scheduling.Appointment.v1.cs" Link="generated/scheduling.Appointment.v1.cs" />
    <Compile Include="../../generated/csharp/scheduling.AppointmentDb.v1.cs" Link="generated/scheduling.AppointmentDb.v1.cs" />
    <Compile Include="../../generated/csharp/scheduling.AppointmentEvent.v1.cs" Link="generated/scheduling.AppointmentEvent.v1.cs" />
    <Compile Include="../../generated/csharp/scheduling.AppointmentReply.v1.cs" Link="generated/scheduling.AppointmentReply.v1.cs" />
    <Compile Include="../../generated/csharp/scheduling.AppointmentRequest.v1.cs" Link="generated/scheduling.AppointmentRequest.v1.cs" />
    <Compile Include="../../generated/csharp/scheduling.AppointmentStatusChanged.v1.cs" Link="generated/scheduling.AppointmentStatusChanged.v1.cs" />
    <Compile Include="../../generated/csharp/scheduling.TimeRange.v0.cs" Link="generated/scheduling.TimeRange.v0.cs" />
    <Compile Include="../../generated/csharp/billing.InvoiceLine.v0.cs" Link="generated/billing.InvoiceLine.v0.cs" />
    <Compile Include="../../generated/csharp/clinical.Diagnosis.v0.cs" Link="generated/clinical.Diagnosis.v0.cs" />
  </ItemGroup>

</Project>