domain thing {
  owner: "test-team"
  contact: "test@example.com"
  description: "Registry-ids evolution fixture, step 4: adds a third registered semantic type while the ledger still carries the step-3 orphan."

  semantic ThingCode: string {
    registry: true
  }

  semantic ThingSlug: string {
    registry: true
  }

  entity Thing @ 1 (additive) {
    @key
    code: ThingCode
    slug: ThingSlug
    name: string
  }
}
