// Proves: `@custom(...)` (annotation:custom) parses and validates.
// UPSTREAM_FINDINGS.md #42: `modelable capabilities` reported this as
// "implemented" on the pinned 1.7.0-1.9.4 releases, but the grammar had no
// production reaching the transformer's `ann_custom` method - a hard parse
// error on every real attempt. Fixed in v1.9.5 (ktjn/modelable#417): the
// grammar gained `"@custom" "(" (IDENT | ESCAPED_STRING) ["," ANNOTATION_EXPR]
// ")" -> ann_custom`. This fixture is that finding's own reproduction,
// promoted from a standalone repro into permanent conformance coverage.
domain customannotation {
  owner: "conformance-fixtures"

  entity Widget @ 1 (additive) {
    @key
    id: uuid
    @custom("audit-tag", "billing-critical")
    name: string
  }
}
