domain patient {
  owner: "clinic-frontdesk-team"
  contact: "frontdesk@modelable-clinic.example"
  description: "Patient identity and contact information for Modelable Clinic."

  semantic PatientId: uuid(7) {
    registry: true
  }

  value ContactDetails {
    email?: string
    phone?: string
  }

  value Address {
    street: string
    city: string
    postalCode: string
    country: string
  }

  entity Patient @ 1 (additive) {
    @key
    @classification("internal")
    patientId: PatientId
    @pii
    legalName: string
    dateOfBirth: date
    @pii
    contact: ContactDetails
    @pii
    address?: Address
    preferredLanguage: string = "en"
    notes?: string
    @server
    createdAt: timestamp
    @server
    updatedAt?: timestamp
  }

  entity Patient @ 2 (additive) {
    @key
    @classification("internal")
    patientId: PatientId
    @pii
    legalName: string
    preferredName?: string
    dateOfBirth: date
    @pii
    contact: ContactDetails
    @pii
    address?: Address
    preferredLanguage: string = "en"
    alternatePhoneNumbers?: array<string>
    @deprecated(replacedBy: "clinicalNotes")
    notes?: string
    @owner("clinical-documentation-team")
    @wire(clickhouse: "string")
    clinicalNotes?: string
    @server
    createdAt: timestamp
    @server
    updatedAt?: timestamp

    access {
      entity * [read]
      property legalName clinic-frontdesk-team [read, write]
      property clinicalNotes clinical-documentation-team [read, write]
    }
  }

  index Patient @ 2 {
    primary patientId

    secondary byName {
      key: [legalName]
      sort: [dateOfBirth]
    }
  }

  auto projections Patient @ 2 {
    db
    request exclude [@server]
    reply
    event
  }

  // Task 9.6: only the create operation is declared here - the API's
  // GET/search endpoints (apps/api/src/patient.rs) take hand-written query
  // parameters with no generated projection to bind them to, so they are an
  // intentional OpenAPI coverage gap (UPSTREAM_FINDINGS.md, Task 9.6 note).
  api Patient @ 2 {
    operation "createPatient" {
      method: POST
      path: "/api/patients"
      request: PatientRequest @ 2
      responses {
        201: PatientReply @ 2
      }
    }
  }
}
